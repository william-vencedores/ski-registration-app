{
  "name": "vencedores-ski-lambda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prebuild:sam": "npm run build",
    "build:sam": "node scripts/prepare-build.mjs",
    "watch": "tsc --watch",
    "deploy": "npm run build:sam && sam build && sam deploy",
    "deploy:guided": "npm run build:sam && sam build && sam deploy --guided"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "resend": "^6.12.4",
    "stripe": "^17.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0"
  }
}
